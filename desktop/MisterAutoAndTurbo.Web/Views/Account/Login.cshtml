@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}

<h1 style="font-size:22px;margin-bottom:4px;">Welcome back</h1>
<p style="color:var(--muted);margin-bottom:24px;">Sign in to Mister Auto &amp; Turbo staff portal</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" style="margin-bottom:16px;padding:10px 12px;border-radius:8px;background:#ecfdf5;color:#065f46;font-size:13px;">
        @TempData["Success"]
    </div>
}

<form asp-action="Login" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

    <div class="field">
        <label>Email or username</label>
        <input class="input" type="text" name="email" placeholder="manager@misterauto.co.za" required autofocus />
    </div>
    <div class="field">
        <label>Password</label>
        <input class="input" type="password" name="password" placeholder="••••••••" required />
    </div>

    <div style="text-align:right;font-size:13px;"><a asp-action="ForgotPassword">Forgot password?</a></div>

    <div asp-validation-summary="All" class="text-danger" style="margin-bottom:12px;"></div>

    <button type="submit" class="btn btn-primary btn-block" style="width:100%;margin-top:8px;">Sign in</button>
</form>
