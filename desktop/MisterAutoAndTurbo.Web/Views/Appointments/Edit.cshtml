@model Appointment
@{
    ViewData["Title"] = "Edit appointment";
}
<div class="page-header">
    <div><h1>Edit appointment</h1></div>
    <a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
</div>
<div class="card" style="max-width:520px;">
<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CustomerId" />
    <input type="hidden" asp-for="VehicleId" />
    <div class="field">
        <label asp-for="ScheduledAt">Scheduled at</label>
        <input class="input" asp-for="ScheduledAt" type="datetime-local" required />
    </div>
    <div class="field">
        <label asp-for="ServiceType">Service type</label>
        <input class="input" asp-for="ServiceType" required />
    </div>
    <div class="field">
        <label asp-for="Status">Status</label>
        <select class="input" asp-for="Status">
            @foreach (var s in new[] { "Pending", "Scheduled", "Completed", "Cancelled" }) {
                <option value="@s" selected="@(s == Model.Status)">@s</option>
            }
        </select>
    </div>
    <div class="field">
        <label asp-for="Description">Notes</label>
        <textarea class="input" asp-for="Description" rows="3"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>
</div>
