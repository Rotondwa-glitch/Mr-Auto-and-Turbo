@model IEnumerable<Appointment>
@{
    ViewData["Title"] = "Appointments";
}

<div class="page-header">
    <div>
        <h1>Appointments</h1>
        <p>Scheduled service bookings.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">New appointment</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>When</th>
            <th>Service</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var a in Model)
    {
        <tr>
            <td>@a.ScheduledAt.ToString("yyyy-MM-dd HH:mm")</td>
            <td>@a.ServiceType</td>
            <td><span class="pill">@a.Status</span></td>
            <td><a asp-action="Details" asp-route-id="@a.Id">View</a></td>
        </tr>
    }
    </tbody>
</table>
