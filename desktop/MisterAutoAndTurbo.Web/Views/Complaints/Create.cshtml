@model Complaint
@{
    ViewData["Title"] = "Log complaint";
}
<div class="page-header">
    <div><h1>Log complaint</h1></div>
    <a class="btn btn-ghost" asp-action="Index">Back</a>
</div>
<div class="card" style="max-width:520px;">
<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div class="field">
        <label asp-for="CustomerId">Customer ID</label>
        <input class="input" asp-for="CustomerId" required />
    </div>
    <div class="field">
        <label asp-for="Subject">Subject</label>
        <input class="input" asp-for="Subject" required />
    </div>
    <div class="field">
        <label asp-for="Description">Description</label>
        <textarea class="input" asp-for="Description" rows="4" required></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Save complaint</button>
</form>
</div>
