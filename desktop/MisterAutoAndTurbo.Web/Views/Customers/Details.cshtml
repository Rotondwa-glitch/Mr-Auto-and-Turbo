@model Customer
@{
    ViewData["Title"] = "Customer details";
    var vehicles = ViewBag.Vehicles as IEnumerable<Vehicle> ?? Enumerable.Empty<Vehicle>();
    var jobs = ViewBag.JobCards as IEnumerable<JobCard> ?? Enumerable.Empty<JobCard>();
}
<div class="page-header">
    <div>
        <h1>@Model.FullName</h1>
        <p>@Model.Email · @Model.Phone</p>
    </div>
    <div>
        <a class="btn btn-ghost" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-primary" asp-controller="Vehicles" asp-action="Create" asp-route-customerId="@Model.Id">Add vehicle</a>
    </div>
</div>
<div class="card">
    <strong>Address</strong>
    <p style="margin:6px 0 0;color:var(--muted);">@(string.IsNullOrWhiteSpace(Model.Address) ? "—" : Model.Address)</p>
</div>
<h2 style="margin:20px 0 10px;font-size:16px;">Vehicles</h2>
<table class="table">
    <thead><tr><th>Registration</th><th>Make</th><th>Model</th><th>Year</th></tr></thead>
    <tbody>
    @foreach (var v in vehicles) {
        <tr>
            <td><a asp-controller="Vehicles" asp-action="Details" asp-route-id="@v.Id">@v.RegistrationNumber</a></td>
            <td>@v.Make</td><td>@v.Model</td><td>@v.Year</td>
        </tr>
    }
    </tbody>
</table>
<h2 style="margin:20px 0 10px;font-size:16px;">Recent job cards</h2>
<table class="table">
    <thead><tr><th>Status</th><th>Description</th><th>Created</th></tr></thead>
    <tbody>
    @foreach (var j in jobs.Take(10)) {
        <tr>
            <td><span class="pill">@j.Status</span></td>
            <td><a asp-controller="JobCards" asp-action="Details" asp-route-id="@j.Id">@j.Description</a></td>
            <td>@j.CreatedAt.ToString("yyyy-MM-dd")</td>
        </tr>
    }
    </tbody>
</table>
