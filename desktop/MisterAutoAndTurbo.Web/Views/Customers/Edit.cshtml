@model Customer
@{
    ViewData["Title"] = "Edit customer";
}
<div class="page-header">
    <div><h1>Edit customer</h1></div>
    <a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
</div>
<div class="card" style="max-width:520px;">
<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="field">
        <label asp-for="FullName">Full name</label>
        <input class="input" asp-for="FullName" required />
    </div>
    <div class="field">
        <label asp-for="Email">Email</label>
        <input class="input" asp-for="Email" type="email" />
    </div>
    <div class="field">
        <label asp-for="Phone">Phone</label>
        <input class="input" asp-for="Phone" />
    </div>
    <div class="field">
        <label asp-for="Address">Address</label>
        <input class="input" asp-for="Address" />
    </div>
    <button type="submit" class="btn btn-primary">Save changes</button>
</form>
</div>
