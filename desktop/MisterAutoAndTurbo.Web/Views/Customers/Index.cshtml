@model IEnumerable<Customer>
@{
    ViewData["Title"] = "Customers";
}

<div class="page-header">
    <div>
        <h1>Customers</h1>
        <p>Registered workshop customers.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Add customer</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.FullName</td>
            <td>@c.Email</td>
            <td>@c.Phone</td>
            <td><a asp-action="Details" asp-route-id="@c.Id">View</a></td>
        </tr>
    }
    </tbody>
</table>
