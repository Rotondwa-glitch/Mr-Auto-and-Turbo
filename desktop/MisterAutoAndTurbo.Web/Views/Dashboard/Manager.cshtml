@{
    ViewData["Title"] = "Manager dashboard";
}
<div class="page-header">
    <div>
        <h1>Manager / Owner</h1>
        <p>Active jobs, performance and payments</p>
    </div>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;">
    <a class="card" asp-controller="JobCards" asp-action="Index" style="padding:20px;display:block;">
        <h3>Active jobs</h3>
        <p style="color:var(--muted);margin:6px 0 0;">View work in progress</p>
    </a>
    <a class="card" asp-action="Performance" style="padding:20px;display:block;">
        <h3>Workshop performance</h3>
        <p style="color:var(--muted);margin:6px 0 0;">KPIs and throughput</p>
    </a>
    <a class="card" asp-controller="Payments" asp-action="Index" style="padding:20px;display:block;">
        <h3>Payments</h3>
        <p style="color:var(--muted);margin:6px 0 0;">Payment records</p>
    </a>
    <a class="card" asp-action="Reports" style="padding:20px;display:block;">
        <h3>Reports</h3>
        <p style="color:var(--muted);margin:6px 0 0;">Jobs and revenue</p>
    </a>
    <a class="card" asp-controller="Users" asp-action="Index" style="padding:20px;display:block;">
        <h3>Staff users</h3>
        <p style="color:var(--muted);margin:6px 0 0;">Manage accounts</p>
    </a>
    <a class="card" asp-controller="Settings" asp-action="Index" style="padding:20px;display:block;">
        <h3>Settings</h3>
        <p style="color:var(--muted);margin:6px 0 0;">Business details</p>
    </a>
</div>
