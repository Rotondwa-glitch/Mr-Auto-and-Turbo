@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div>
        <h1>Workshop overview</h1>
        <p>Live snapshot of open work and upcoming activity.</p>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <span class="stat-label">Open jobs</span>
        <strong class="stat-value">@(ViewBag.OpenJobs ?? 0)</strong>
    </div>
    <div class="stat-card">
        <span class="stat-label">Pending appointments</span>
        <strong class="stat-value">@(ViewBag.PendingAppointments ?? 0)</strong>
    </div>
    <div class="stat-card">
        <span class="stat-label">Open complaints</span>
        <strong class="stat-value">@(ViewBag.OpenComplaints ?? 0)</strong>
    </div>
    <div class="stat-card">
        <span class="stat-label">Ready for collection</span>
        <strong class="stat-value">@(ViewBag.ReadyForCollection ?? 0)</strong>
    </div>
</div>

<p style="margin-top:24px;color:var(--muted);">Use the sidebar to manage customers, job cards, quotations and more.</p>
