@model IEnumerable<Inspection>
@{
    ViewData["Title"] = "Inspections";
}
<div class="page-header">
    <div>
        <h1>Inspections</h1>
        <p>Vehicle inspection records linked to job cards</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Record inspection</a>
</div>

@if (!Model.Any())
{
    <div class="card"><p style="color:var(--muted);margin:0;">No inspections yet.</p></div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>When</th>
                <th>Job card</th>
                <th>Notes</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var i in Model.OrderByDescending(x => x.InspectedAt))
        {
            <tr>
                <td>@i.InspectedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td><a asp-controller="JobCards" asp-action="Details" asp-route-id="@i.JobCardId">@i.JobCardId.Substring(0, Math.Min(8, i.JobCardId.Length))…</a></td>
                <td>@(i.Notes.Length > 80 ? i.Notes.Substring(0, 80) + "…" : i.Notes)</td>
            </tr>
        }
        </tbody>
    </table>
}
