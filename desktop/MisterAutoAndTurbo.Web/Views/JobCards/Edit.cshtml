@model JobCard
@{
    ViewData["Title"] = "Edit job card";
    var statuses = JobStatus.All;
}
<div class="page-header">
    <div><h1>Edit job card</h1></div>
    <a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
</div>
<div class="card" style="max-width:560px;">
<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CustomerId" />
    <input type="hidden" asp-for="VehicleId" />
    <div class="field">
        <label asp-for="Description">Description</label>
        <textarea class="input" asp-for="Description" rows="3" required></textarea>
    </div>
    <div class="field">
        <label asp-for="Status">Status</label>
        <select class="input" asp-for="Status">
            @foreach (var s in statuses) {
                <option value="@s" selected="@(s == Model.Status)">@s</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Save changes</button>
</form>
</div>
