@model IEnumerable<Notification>
@{
    ViewData["Title"] = "Notifications";
}
<div class="page-header">
    <div><h1>Notifications</h1><p>Your in-app alerts.</p></div>
</div>
@if (!Model.Any())
{
    <div class="card"><p style="color:var(--muted);margin:0;">No notifications.</p></div>
}
else
{
    foreach (var n in Model)
    {
        <div class="card">
            <strong>@n.Type</strong>
            <p style="margin:6px 0 0;color:var(--muted);">@n.Message</p>
            <small>@n.CreatedAt.ToString("yyyy-MM-dd HH:mm") @(n.IsRead ? "· read" : "· unread")</small>
        </div>
    }
}
