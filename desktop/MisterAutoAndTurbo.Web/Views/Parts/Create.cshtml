@model Part
@{
    ViewData["Title"] = "Add part";
}
<div class="page-header">
    <div><h1>Add part</h1></div>
    <a class="btn btn-ghost" asp-action="Index">Back</a>
</div>
<div class="card" style="max-width:480px;">
<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div class="field"><label asp-for="Name">Name</label><input class="input" asp-for="Name" required /></div>
    <div class="field"><label asp-for="Sku">SKU</label><input class="input" asp-for="Sku" /></div>
    <div class="field"><label asp-for="UnitPrice">Unit price (R)</label><input class="input" asp-for="UnitPrice" type="number" step="0.01" /></div>
    <div class="field"><label asp-for="StockQuantity">Stock quantity</label><input class="input" asp-for="StockQuantity" type="number" /></div>
    <button type="submit" class="btn btn-primary">Save part</button>
</form>
</div>
