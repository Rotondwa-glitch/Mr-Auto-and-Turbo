@model Quotation
@{
    ViewData["Title"] = "Quotation";
    var customer = ViewBag.Customer as Customer;
    var vehicle = ViewBag.Vehicle as Vehicle;
}
<div class="page-header">
    <div>
        <h1>Quotation</h1>
        <p><span class="pill">@Model.Status</span> · R @Model.TotalAmount.ToString("N2")</p>
    </div>
</div>
<div class="card">
    @if (customer != null) {
        <p><strong>Customer</strong><br />@customer.FullName · @customer.Email</p>
    }
    @if (vehicle != null) {
        <p style="margin-top:12px;"><strong>Vehicle</strong><br />@vehicle.RegistrationNumber — @vehicle.Make @vehicle.Model</p>
    }
    <p style="margin-top:12px;"><strong>Notes</strong><br />@(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)</p>
    <p style="margin-top:12px;color:var(--muted);">Created @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>
</div>
<div class="card">
    <form asp-action="UpdateStatus" method="post" style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="field" style="margin:0;min-width:160px;">
            <label>Status</label>
            <select class="input" name="status">
                @foreach (var s in QuotationStatus.All) {
                    <option value="@s" selected="@(s == Model.Status)">@s</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Update</button>
    </form>
</div>
