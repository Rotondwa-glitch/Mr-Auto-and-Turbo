@model IEnumerable<Quotation>
@{
    ViewData["Title"] = "Quotations";
}

<div class="page-header">
    <div>
        <h1>Quotations</h1>
        <p>Quotes sent to customers.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">New quotation</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Status</th>
            <th>Amount</th>
            <th>Created</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var q in Model)
    {
        <tr>
            <td><span class="pill">@q.Status</span></td>
            <td>R @q.TotalAmount.ToString("N2")</td>
            <td>@q.CreatedAt.ToString("yyyy-MM-dd")</td>
            <td><a asp-action="Details" asp-route-id="@q.Id">View</a></td>
        </tr>
    }
    </tbody>
</table>
