@model MisterAutoAndTurbo.Web.ViewModels.SettingsViewModel
@{
    ViewData["Title"] = "Settings";
}
<div class="page-header">
    <div><h1>Business settings</h1><p>Workshop details and VAT.</p></div>
</div>
<div class="card" style="max-width:480px;">
<form asp-action="Index" method="post">
    @Html.AntiForgeryToken()
    <div class="field">
        <label asp-for="BusinessName"></label>
        <input class="input" asp-for="BusinessName" />
    </div>
    <div class="field">
        <label asp-for="VatNumber"></label>
        <input class="input" asp-for="VatNumber" />
    </div>
    <div class="field">
        <label asp-for="Address"></label>
        <input class="input" asp-for="Address" />
    </div>
    <div class="field">
        <label asp-for="Currency"></label>
        <input class="input" asp-for="Currency" />
    </div>
    <div class="field">
        <label asp-for="VatRate"></label>
        <input class="input" asp-for="VatRate" />
    </div>
    <button type="submit" class="btn btn-primary">Save settings</button>
</form>
</div>
