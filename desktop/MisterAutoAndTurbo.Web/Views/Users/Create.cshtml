@model MisterAutoAndTurbo.Web.ViewModels.UserCreateViewModel
@{
    ViewData["Title"] = "Add user";
    var roles = ViewBag.Roles as string[] ?? UserRoles.All;
}
<div class="page-header">
    <div><h1>Add staff user</h1></div>
    <a class="btn btn-ghost" asp-action="Index">Back</a>
</div>
<div class="card" style="max-width:480px;">
<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div class="field"><label asp-for="FullName">Full name</label><input class="input" asp-for="FullName" required /></div>
    <div class="field"><label asp-for="Email">Email</label><input class="input" asp-for="Email" type="email" required /></div>
    <div class="field"><label asp-for="Password">Password</label><input class="input" asp-for="Password" type="password" required /></div>
    <div class="field">
        <label asp-for="Role">Role</label>
        <select class="input" asp-for="Role">
            @foreach (var r in roles) { <option value="@r">@r</option> }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Create user</button>
</form>
</div>
