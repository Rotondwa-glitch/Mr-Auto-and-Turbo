@model MisterAutoAndTurbo.Web.ViewModels.UserEditViewModel
@{
    ViewData["Title"] = "Edit user";
    var roles = ViewBag.Roles as string[] ?? UserRoles.All;
}
<div class="page-header">
    <div><h1>Edit user</h1></div>
    <a class="btn btn-ghost" asp-action="Index">Back</a>
</div>
<div class="card" style="max-width:480px;">
<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="field"><label asp-for="FullName">Full name</label><input class="input" asp-for="FullName" required /></div>
    <div class="field"><label asp-for="Email">Email</label><input class="input" asp-for="Email" type="email" required /></div>
    <div class="field">
        <label asp-for="Role">Role</label>
        <select class="input" asp-for="Role">
            @foreach (var r in roles) { <option value="@r" selected="@(r == Model.Role)">@r</option> }
        </select>
    </div>
    <div class="field"><label asp-for="NewPassword">New password (optional)</label><input class="input" asp-for="NewPassword" type="password" /></div>
    <button type="submit" class="btn btn-primary">Save changes</button>
</form>
</div>
