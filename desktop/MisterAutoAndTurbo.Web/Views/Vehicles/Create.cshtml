@model Vehicle
@{
    ViewData["Title"] = "Register vehicle";
    var customers = ViewBag.Customers as IEnumerable<Customer> ?? Enumerable.Empty<Customer>();
}
<div class="page-header">
    <div><h1>Register vehicle</h1></div>
    <a class="btn btn-ghost" asp-action="Index">Back</a>
</div>
<div class="card" style="max-width:520px;">
<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div class="field">
        <label>Customer</label>
        <select class="input" asp-for="CustomerId" required>
            <option value="">— Select —</option>
            @foreach (var c in customers) {
                <option value="@c.Id">@c.FullName</option>
            }
        </select>
    </div>
    <div class="field">
        <label asp-for="RegistrationNumber">Registration</label>
        <input class="input" asp-for="RegistrationNumber" required />
    </div>
    <div class="field">
        <label asp-for="Make">Make</label>
        <input class="input" asp-for="Make" required />
    </div>
    <div class="field">
        <label asp-for="Model">Model</label>
        <input class="input" asp-for="Model" required />
    </div>
    <div class="field">
        <label asp-for="Year">Year</label>
        <input class="input" asp-for="Year" type="number" />
    </div>
    <div class="field">
        <label asp-for="Mileage">Mileage</label>
        <input class="input" asp-for="Mileage" type="number" />
    </div>
    <button type="submit" class="btn btn-primary">Save vehicle</button>
</form>
</div>
